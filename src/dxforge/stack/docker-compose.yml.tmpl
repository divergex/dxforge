name: forge

networks:
  backend:
    driver: bridge

volumes:
  postgres-data:
  minio-data:
  openbao-data:
  registry-data:
  registry-auth:

# credentials come from secrets/compose.env, which forge derives from ./secrets on
# every invocation; a .env here overrides

services:
  postgres:
    #   docker buildx imagetools inspect postgres:14.24 --format '{{.Manifest.Digest}}'
    image: postgres:14.24@sha256:14bfab572eec6abf65892e1db7c3ba8d41b2a2855c1b143664907d6e146eb6e1
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-forge}
      POSTGRES_DB: ${POSTGRES_DB:-forge}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?run forge init first}
    ports:
      - '127.0.0.1:${POSTGRES_PORT:-5432}:5432'
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - backend
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U ${POSTGRES_USER:-forge} -d ${POSTGRES_DB:-forge}']
      interval: 5s
      timeout: 5s
      retries: 10

  minio:
    image: cgr.dev/chainguard/minio@sha256:25bc63a89475bc494bfbce9bbeddb0421aece3f3968d77c809db5104d07b4545
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?run forge init first}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?run forge init first}
    command: server /data --console-address ":9001"
    ports:
      - '127.0.0.1:${MINIO_API_PORT:-9000}:9000'
      - '127.0.0.1:${MINIO_CONSOLE_PORT:-9001}:9001'
    volumes:
      - minio-data:/data
    networks:
      - backend
    # The Chainguard image ships no shell or HTTP client, so it cannot carry a
    # CMD-SHELL healthcheck. minio-bootstrap polls the health endpoint instead.

  # creates the tenant-code bucket + scoped service accounts & safe to re run
  minio-bootstrap:
    image: @@DXFORGE_IMAGE@@
    depends_on:
      - minio
    environment:
      APP_UID: ${APP_UID:-1000}
      APP_GID: ${APP_GID:-1000}
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?run forge init first}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?run forge init first}
    volumes:
      - ./bootstrap/minio:/scripts:ro,z
      - ./secrets:/secrets:z
    networks:
      - backend
    entrypoint: ['/bin/sh', '/scripts/init.sh']

  openbao:
    image: openbao/openbao:2.7.1@sha256:6d2b93856e3fcf7b18ad855a0b51eaba474dc8b79cf554379ea32034797d2acf
    user: root
    cap_add:
      - IPC_LOCK
    environment:
      BAO_LOCAL_CONFIG: >
        {"storage": {"raft": {"path": "/openbao/file/raft", "node_id": "forge-node-1"}},
         "listener": [{"tcp": {"address": "0.0.0.0:8200", "tls_disable": true}}],
         "api_addr": "http://openbao:8200",
         "cluster_addr": "http://openbao:8201"}
    command: ['/bin/sh', '-c', 'mkdir -p /openbao/file/raft && exec bao server -config=/openbao/config']
    ports:
      - '127.0.0.1:${OPENBAO_PORT:-8200}:8200'
    volumes:
      - openbao-data:/openbao/file
    networks:
      - backend
    healthcheck:
      # Exit 2 (sealed-but-reachable) still counts as "up"; unsealed is 0.
      test: ['CMD-SHELL', 'bao status -address http://127.0.0.1:8200 >/dev/null 2>&1 || test $? -eq 2']

  # writes root token + unseal keys to ./secrets, unseals it on every run, and configures the
  # transit engine + policies + tokens. can also be re run
  openbao-bootstrap:
    image: openbao/openbao:2.7.1@sha256:6d2b93856e3fcf7b18ad855a0b51eaba474dc8b79cf554379ea32034797d2acf
    user: root
    environment:
      APP_UID: ${APP_UID:-1000}
      APP_GID: ${APP_GID:-1000}
    depends_on:
      openbao:
        condition: service_started
    volumes:
      - ./bootstrap/openbao:/scripts:ro,z
      - ./secrets:/secrets:z
    networks:
      - backend
    entrypoint: ['/bin/sh', '/scripts/init-unseal.sh']

  registry:
    image: registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
    environment:
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: 'Forge Registry'
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
    ports:
      - '127.0.0.1:${REGISTRY_PORT:-5001}:5000'
    volumes:
      - registry-data:/var/lib/registry
      - registry-auth:/auth
    networks:
      - backend
    healthcheck:
      # Any HTTP response (incl. 401 auth challenge) means the registry container is at least
      # up and listening
      test: ['CMD-SHELL', 'wget -q -S --spider http://localhost:5000/v2/ 2>&1 | grep -q HTTP/']
      interval: 5s
      timeout: 5s
      retries: 10

  registry-bootstrap:
    image: httpd:2.4.69-alpine@sha256:3440c39d8d6f54fa9ad2549e5a60c19ddd435faadc29c1ad28aa795f71888889
    environment:
      APP_UID: ${APP_UID:-1000}
      APP_GID: ${APP_GID:-1000}
    volumes:
      - ./bootstrap/registry:/scripts:ro,z
      - registry-auth:/auth
      - ./secrets:/secrets:z
    entrypoint: ['/bin/sh', '/scripts/init.sh']

  # creates/updates the RLS-scoped application role, then applies migrations. Both run
  # the published dxforge image, so no checkout is needed on the host.
  db-prepare-role:
    image: @@DXFORGE_IMAGE@@
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      FORGE_STACK_DIR: /stack
      POSTGRES_APP_USER: ${POSTGRES_APP_USER:-forge_app}
      FORGE_MIGRATE_URL: postgresql+psycopg://${POSTGRES_USER:-forge}:${POSTGRES_PASSWORD:?run forge init first}@postgres:5432/${POSTGRES_DB:-forge}
      FORGE_DATABASE_URL: postgresql+psycopg://${POSTGRES_APP_USER:-forge_app}:${POSTGRES_APP_PASSWORD:?run forge init first}@postgres:5432/${POSTGRES_DB:-forge}
    volumes:
      - ./:/stack:ro,z
    networks:
      - backend
    command: ['db', 'prepare-role']

  db-migrate:
    image: @@DXFORGE_IMAGE@@
    depends_on:
      postgres:
        condition: service_healthy
      db-prepare-role:
        condition: service_completed_successfully
    environment:
      FORGE_STACK_DIR: /stack
      FORGE_MIGRATE_URL: postgresql+psycopg://${POSTGRES_USER:-forge}:${POSTGRES_PASSWORD:?run forge init first}@postgres:5432/${POSTGRES_DB:-forge}
    volumes:
      - ./:/stack:ro,z
    networks:
      - backend
    command: ['migrate']
