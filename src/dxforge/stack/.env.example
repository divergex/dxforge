# Rendered into the stack directory by `forge init`; copy to .env there.
# docker compose reads it from the project directory for substitution.
# The forge CLI seeds the same FORGE_* values from ./secrets, so this file is
# only needed to override the defaults.

# Compose/infra variables (read by docker compose; defaults shown)
POSTGRES_USER=forge
POSTGRES_DB=forge
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OPENBAO_PORT=8200
REGISTRY_PORT=5001

# Application variables (FORGE_*). Root secrets are generated by `forge init`
# into ./secrets; `forge bootstrap` fills in the derived tokens.
FORGE_DATABASE_URL=postgresql+psycopg://forge_app:REPLACE@127.0.0.1:5432/forge
# Superuser URL for alembic migrations (DDL); falls back to FORGE_DATABASE_URL.
# FORGE_MIGRATE_URL=postgresql+psycopg://forge:REPLACE@127.0.0.1:5432/forge
FORGE_MINIO_ENDPOINT=127.0.0.1:9000
FORGE_MINIO_BUCKET=tenant-code
FORGE_MINIO_INGEST_ACCESS_KEY=app-server-key
FORGE_MINIO_INGEST_SECRET_KEY=REPLACE
FORGE_MINIO_EXEC_ACCESS_KEY=worker-key
FORGE_MINIO_EXEC_SECRET_KEY=REPLACE
FORGE_BAO_ADDR=http://127.0.0.1:8200
FORGE_BAO_INGEST_TOKEN=REPLACE
FORGE_BAO_EXEC_TOKEN=REPLACE
FORGE_TRANSIT_KEY=tenant-code
